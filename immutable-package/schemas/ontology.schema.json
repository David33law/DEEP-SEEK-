{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "ontology.schema.json",
 "title": "LAWMAX capability ontology (protocol 03)",
 "description": "Referenced by protocols/03-LAWMAX-CAPABILITY-ONTOLOGY.yaml. In v2.0 that reference pointed at a file that did not exist, so the ontology was never validated against anything.",
 "type": "object",
 "additionalProperties": false,
 "required": ["meta", "levels", "zones", "capabilities"],
 "properties": {
  "meta": {
   "type": "object",
   "additionalProperties": false,
   "required": ["version", "frozen_at_state", "edit_policy"],
   "properties": {
    "version": {"type": "string", "minLength": 1},
    "frozen_at_state": {"type": "string", "minLength": 1},
    "edit_policy": {"type": "string", "minLength": 1}
   }
  },
  "levels": {
   "type": "object",
   "minProperties": 3,
   "propertyNames": {"pattern": "^[A-Z]$"},
   "patternProperties": {"^[A-Z]$": {"type": "string", "minLength": 3}}
  },
  "zones": {
   "type": "object",
   "minProperties": 2,
   "propertyNames": {"pattern": "^[A-Z][0-9]$"},
   "patternProperties": {"^[A-Z][0-9]$": {"type": "string", "minLength": 3}}
  },
  "capabilities": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "level", "zone", "evidence", "tests"],
    "properties": {
     "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"},
     "level": {"type": "string", "pattern": "^[A-Z]$"},
     "zone": {"type": "string", "pattern": "^[A-Z][0-9]$"},
     "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
     "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
     "depends_on": {"type": "array", "items": {"type": "string"}},
     "note": {"type": "string"}
    }
   }
  }
 }
}

{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "pareto-dimensions.schema.json",
 "title": "pareto-dimensions",
 "description": "v2.0 typed hard_minimum as [number, string], so the string \"none\" validated cleanly and reached the dominance engine, where it was compared against a float. \"No hard minimum\" is an ABSENCE, and absence in JSON is null — never a word that happens to spell it.",
 "type": "array",
 "minItems": 1,
 "items": {
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "direction", "unit", "scale", "measurement", "noise_floor", "hard_minimum", "source_artifact"],
  "properties": {
   "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
   "direction": {"enum": ["higher", "lower"]},
   "unit": {"type": "string", "minLength": 1},
   "scale": {"type": "string", "minLength": 1},
   "measurement": {"type": "string", "minLength": 3},
   "noise_floor": {"type": ["number", "null"]},
   "hard_minimum": {"type": ["number", "null"]},
   "source_artifact": {"type": "string", "minLength": 1}
  }
 }
}
